
@model IEnumerable<ToDoTask.Models.TaskItem>

@{
    ViewData["Title"] = "My Tasks";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold">My Tasks</h1>
            <p class="text-muted mb-0">Manage all your tasks in one place.</p>
        </div>

        <a asp-controller="Tasks"
           asp-action="Create"
           class="btn btn-primary btn-lg">
            + Create New Task
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var task in Model)
            {
                var now = DateTime.Now;
                var deadline = task.Deadline;
                var timeRemaining = deadline - now;

                var isDueSoon =
                    timeRemaining.TotalSeconds > 0 &&
                    timeRemaining.TotalHours <= 24;

                var isOverdue = deadline < now;

                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100 border-0 rounded-4">

                        <div class="card-body p-4">

                            <h4 class="fw-bold text-break">
                                @task.Title
                            </h4>

                            <p class="text-muted text-break"
                               style="white-space: pre-wrap;">@task.Description</p>

                            <div class="mb-3">

                                <span class="fw-bold">Deadline:</span>

                                <div class="mt-2">
                                    <span class="@(isDueSoon || isOverdue ? "deadline-warning" : "")">
                                        <i class="bi bi-calendar-event"></i>
                                        @task.Deadline.ToString("dd MMM yyyy hh:mm tt")
                                    </span>
                                </div>

                                @if (isDueSoon)
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-danger">
                                            Deadline within 24 hours!
                                        </span>
                                    </div>
                                }
                                else if (isOverdue)
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-secondary">
                                            Overdue
                                        </span>
                                    </div>
                                }

                            </div>

                            <div class="mb-3">

                                @if (!string.IsNullOrWhiteSpace(task.Attachment))
                                {
                                    <span class="badge bg-success">
                                        Attachment available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        No attachment
                                    </span>
                                }

                            </div>

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-controller="Tasks"
                                   asp-action="Edit"
                                   asp-route-id="@task.Id"
                                   class="btn btn-warning">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </a>

                                @if (!string.IsNullOrWhiteSpace(task.Attachment))
                                {
                                    <a asp-controller="Tasks"
                                       asp-action="Download"
                                       asp-route-id="@task.Id"
                                       class="btn btn-success">
                                        <i class="bi bi-download"></i>
                                        Download
                                    </a>
                                }

                                <form asp-controller="Tasks"
                                      asp-action="Delete"
                                      asp-route-id="@task.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this task?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger">
                                        <i class="bi bi-trash"></i>
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">

            <h3>No tasks found</h3>

            <p class="text-muted">
                Create your first task to get started.
            </p>

            <a asp-controller="Tasks"
               asp-action="Create"
               class="btn btn-primary">
                Create Task
            </a>

        </div>
    }

</div>
