@model ToDoTask.Models.TaskItem

@{
    ViewData["Title"] = "Edit Task";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-primary text-white p-4">
                    <h2 class="mb-1">Edit Task</h2>
                    <p class="mb-0">Update your task details below.</p>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="Tasks"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title"
                                   class="form-label fw-bold">
                                Task Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label fw-bold">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                       
                        @{
                            var today = DateTime.Now;
                            var deadline = Model.Deadline;
                            var isDueTomorrow =
                                deadline.Date == today.Date.AddDays(1);

                            var isOverdue = deadline < today;
                        }

                        <div class="mb-3">
                            <span class="fw-bold">Deadline:</span>

                            <span class="@(isDueTomorrow || isOverdue ? "deadline-warning" : "")">
                                @Model.Deadline.ToString("dd MMM yyyy hh:mm tt")
                            </span>

                            @if (isDueTomorrow)
                            {
                                <span class="badge bg-danger ms-2">Due Tomorrow!</span>
                            }
                            else if (isOverdue)
                            {
                                <span class="badge bg-secondary ms-2">Overdue</span>
                            }
                        </div>


                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Current Attachment
                            </label>

                            @if (!string.IsNullOrWhiteSpace(Model.Attachment))
                            {
                                <div class="alert alert-light border">
                                    <div class="mb-2">
                                        Current file:
                                        <strong>
                                            @System.IO.Path.GetFileName(Model.Attachment)
                                        </strong>
                                    </div>

                                    <a asp-controller="Tasks"
                                       asp-action="Download"
                                       asp-route-id="@Model.Id"
                                       class="btn btn-outline-success btn-sm">
                                        Download Current File
                                    </a>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">
                                    No file attached to this task.
                                </p>
                            }

                            <label for="attachmentFile"
                                   class="form-label fw-bold">
                                Choose a New File (Optional)
                            </label>

                            <input type="file"
                                   id="attachmentFile"
                                   name="attachmentFile"
                                   class="form-control" />

                            <div class="form-text">
                                Leave this empty to keep the current file.
                                Maximum size: 10 MB.
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn btn-primary btn-lg">
                                Save Changes
                            </button>

                            <a asp-controller="Tasks"
                               asp-action="Index"
                               class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
